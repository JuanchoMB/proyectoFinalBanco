<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="240.0" prefWidth="292.0" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.proyectofinalbancouq.controllers.TransaccionController">
    <VBox alignment="CENTER" layoutY="-7.0" prefHeight="247.0" prefWidth="304.0" spacing="10" style="-fx-background-color: black;">
        <Label text="Realizar Transacción" textFill="WHITE">
            <font>
                <Font name="Arial Bold" size="20.0" />
            </font>
        </Label>
        <TextField fx:id="txtCantidad" promptText="Cantidad" />
        <TextField fx:id="txtDescripcion" promptText="Descripción (opcional)" />
        <ComboBox fx:id="cbCuentaOrigen" promptText="Seleccionar cuenta origen" />
        <ComboBox fx:id="cbCuentaDestino" promptText="Seleccionar cuenta destino" />
        <ComboBox fx:id="cbCategoria" promptText="Seleccionar categoría" />
        <HBox spacing="10">
            <Button onAction="#manejarDeposito" text="Depositar" />
            <Button onAction="#manejarRetiro" text="Retirar" />
            <Button onAction="#manejarTransferencia" text="Transferir" />
        </HBox>
    </VBox>
</AnchorPane>
